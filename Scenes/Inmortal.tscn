[ext_resource type="Texture2D" uid="uid://c0kxqimp6s72g" path="res://Top-Down_Retro_Interior/mystic_woods_free_2.2/sprites/characters/Basic Undead Animations/Vampire Bat/VampireBat.png" id="1_bcbr7"]

[sub_resource type="GDScript" id="GDScript_n7tue"]
script/source = "extends CharacterBody2D

@export var speed: float = 60.0
@export var chase_speed: float = 120.0
@export var dano: float = 10.0
@export var detection_distance: float
@export var attack_range: float = 50.0

var vida = 1000
var state = \"idle\"
var direction = Vector2.ZERO
var change_dir_time = 0.0
var can_attack = true
var preparing_attack = false

@onready var anim = $AnimatedSprite2D
@onready var player = get_tree().get_first_node_in_group(\"player\")
@onready var agent = $NavigationAgent2D
@onready var attack_area = $Area2D

func _ready():
	randomize()
	anim.play(\"default\")
	set_random_direction()
	
	if attack_area:
		attack_area.monitoring = false

func _physics_process(delta):
	
	if player == null:
		return
	
	if preparing_attack:
		move_and_slide()
		return
	
	match state:
		\"idle\":
			idle_behavior(delta)
	
		\"chase\":
			chase_behavior()
	
	move_and_slide()
	
	try_attack()

# =========================
# PATRULLA
# =========================

func idle_behavior(delta):
	
	change_dir_time -= delta
	
	if change_dir_time <= 0:
		set_random_direction()
	
	velocity = direction * speed
	
	if can_detect_player():
		state = \"chase\"

func set_random_direction():
	
	direction = Vector2(
		randf_range(-1.0, 1.0),
		randf_range(-1.0, 1.0)
	).normalized()
	
	change_dir_time = randf_range(1.0, 3.0)

# =========================
# PERSECUCIÓN
# =========================

func chase_behavior():

	if !can_detect_player():
		state = \"idle\"
		return

	var distance = global_position.distance_to(player.global_position)

	# Si ya está en rango de ataque se detiene
	if distance <= attack_range:
		velocity = Vector2.ZERO
		return

	agent.target_position = player.global_position

	var next_position = agent.get_next_path_position()

	velocity = global_position.direction_to(next_position) * chase_speed

# =========================
# DETECCIÓN
# =========================

func can_detect_player() -> bool:
	
	if player == null:
		return false
	
	return global_position.distance_to(player.global_position) <= detection_distance

# =========================
# ATAQUE
# =========================

func try_attack():
	
	if !can_attack or preparing_attack:
		return
	
	var distance = global_position.distance_to(player.global_position)
	
	if distance <= attack_range:
		attack()

func attack():
	
	if !can_attack:
		return
	
	can_attack = false
	preparing_attack = true
	
	# Se detiene para cargar el golpe
	velocity = Vector2.ZERO
	
	# Se pone rojo
	anim.modulate = Color.RED
	
	# Tiempo para que el jugador reaccione
	await get_tree().create_timer(0.5).timeout
	
	# ¿El jugador sigue cerca?
	if player != null:
	
		var distance = global_position.distance_to(player.global_position)
	
		if distance <= attack_range:
	
			# Muerte instantánea
			if player.has_method(\"recibir_dano\"):
				player.recibir_dano(dano)
	
	# Vuelve al color normal
	anim.modulate = Color.WHITE
	
	preparing_attack = false
	
	# Cooldown
	await get_tree().create_timer(1.0).timeout
	
	can_attack = true
"

